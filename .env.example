# TulSip Media — Public Environment Configuration Example
# Copy this file to .env.local for local overrides.
# IMPORTANT: Never store private API keys, database credentials, or SMTP passwords in VITE_* variables.
# Variables prefixed with VITE_ are embedded into the public client bundle.

# Google Analytics 4 Measurement ID (Public)
VITE_GA_MEASUREMENT_ID=G-11KLKCN7BW
